; Engine configuration file.
; Godot 4.7.2-stable

config_version=5

[application]

config/name="Germ Arena"
; Ayarlar ekranı bunu oxuyur (bax [SettingsView]). `export_presets.cfg`-dəki
; `version/name` ilə eyni saxlanmalıdır: oyunçunun dediyi versiya ilə mağazanın
; yazdığı versiya fərqlənsə, xəta hesabatı hansı buraxılışa aiddir bilinmir.
config/version="1.0"
config/description="Onlayn io tipli mikrob arenası — 10 nəfərlik sonsuz dünya"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
; Android-in GERİ jesti tətbiqi BİRBAŞA bağlamasın: matçda o, çıxış təsdiqini
; açır (bax [Arena._notification]), menyuda isə əvvəl açıq vərəqi/ayarları
; bağlayır və yalnız ana ekranda oyundan çıxır (bax [MenuV2._notification]).
config/quit_on_go_back=false
; Açılış ekranı — Godot loqosu yox, oyunun öz loqosu (bax design/menu_art/README.md,
; «Loqo»). Fon `default_clear_color` ilə EYNİDİR: mühərrikin açılış şəkli menyu
; çəkilənə qədər oyunun içində də davam edir ([BootLogo]) və ikisi arasında keçid
; görünməməlidir. Şəkil 16:9-dur, `Keep` rejimində ekrana sığır.
boot_splash/bg_color=Color(0.027451, 0.058824, 0.070588, 1)
boot_splash/image="res://assets/ui/boot_splash.png"

[autoload]

Const="*res://scripts/shared/constants.gd"
Net="*res://scripts/shared/net.gd"
; Sıra vacibdir: Settings səs şinlərini yaradır, Sfx isə hovuzunu MƏHZ o
; şinlərə bağlayır — sonra gəlsəydi, kanallar mövcud olmayan şinə yazardı.
Settings="*res://scripts/shared/settings.gd"
Sfx="*res://scripts/client/sfx.gd"
; Dostlar və komanda — menyu ilə arena arasında yaşamalıdır (bax friends.gd).
; Net-dən SONRA: qoşulma siqnalına Net-in öz _ready-sindən sonra bağlanır.
Friends="*res://scripts/client/friends.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

; Şrift teması — bax assets/ui/theme.tres.
theme/custom="res://assets/ui/theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.027451, 0.058824, 0.070588, 1)
